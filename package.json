{
  "name": "aifi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "dev:desktop": "pnpm --filter @aifi/desktop dev",
    "build": "pnpm --filter @aifi/web build && pnpm --filter @aifi/desktop build",
    "check": "tsc --noEmit",
    "preview": "pnpm --filter @aifi/web preview",
    "desktop": "pnpm --filter @aifi/desktop start",
    "test": "vitest run packages/core/src packages/platform/src packages/host/src packages/ui/src",
    "smoke:desktop": "pnpm --filter @aifi/desktop smoke",
    "smoke:account": "node scripts/check-account-ui.mjs",
    "smoke:chatgpt": "node scripts/check-chatgpt.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json,css}\" \"scripts/*.mjs\" package.json tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "prettier": "3.9.10"
  }
}
